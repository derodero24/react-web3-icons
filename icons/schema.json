          "additionalProperties": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]*\\.svg$",
                "description": "a sibling .svg file name"
              },
              "fill": {
                "type": "string",
                "pattern": "^(?:none|currentColor|#(?:[0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8}))$",
                "description": "none, currentColor, or a hex color"
              }
            },
            "required": [
              "file"
            ],
            "additionalProperties": false
          }
        },
        "deprecated": {
          "type": "object",
