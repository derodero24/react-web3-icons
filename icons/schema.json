            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "description": "a PascalCase identifier"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?!.*\\*\\/)[^\\r\\n\\u2028\\u2029]+$",
            "description": "a non-empty single-line message without \"*/\""
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9 .-]*$",
            "description": "a lowercase search term"
          }
        },
        "reexport": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^(?:\\.\\/|\\.\\.\\/[a-z]+\\/)[A-Z][A-Za-z0-9]*$",
