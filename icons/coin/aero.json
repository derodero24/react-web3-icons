{
  "$schema": "../schema.json",
  "name": "Aero",
  "source": [
    "re-export of Aerodrome — see src/dex/Aerodrome.tsx"
  ],
  "notes": [
    "The AERO token logo is the Aerodrome mark (CoinGecko token image, checked 2026-10-24), so the coin re-exports the dex icon"
  ],
  "kind": "reexport",
  "reexport": {
    "from": "../dex/Aerodrome",
    "exports": [
      {
        "of": "Aerodrome",
        "as": "Aero"
      },
      {
        "of": "AerodromeMono",
        "as": "AeroMono"
      }
    ]
  },
  "tickers": [
    "AERO"
  ]
}
