{
  "$schema": "../schema.json",
  "name": "Stg",
  "source": [
    "re-export of Stargate — see src/bridge/Stargate.tsx"
  ],
  "notes": [
    "The STG token logo is the Stargate mark (CoinGecko token image, checked 2026-10-24), so the coin re-exports the bridge icon"
  ],
  "kind": "reexport",
  "reexport": {
    "from": "../bridge/Stargate",
    "exports": [
      {
        "of": "Stargate",
        "as": "Stg"
      },
      {
        "of": "StargateMono",
        "as": "StgMono"
      }
    ]
  },
  "tickers": [
    "STG"
  ]
}
