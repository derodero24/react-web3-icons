{
  "$schema": "../schema.json",
  "name": "Bnb",
  "source": [
    "re-export of BnbSmartChain — see src/chain/BnbSmartChain.tsx. Both units drew the same official BNB Chain symbol (BNB Chain_Symbol_Yellow.svg), so the artwork now lives in one place"
  ],
  "kind": "reexport",
  "reexport": {
    "from": "../chain/BnbSmartChain",
    "exports": [
      {
        "of": "BnbSmartChain",
        "as": "Bnb"
      },
      {
        "of": "BnbSmartChainMono",
        "as": "BnbMono"
      },
      {
        "of": "BnbSmartChainCircle",
        "as": "BnbCircle"
      },
      {
        "of": "BnbSmartChainCircleMono",
        "as": "BnbCircleMono"
      }
    ]
  },
  "tickers": [
    "BNB"
  ]
}
