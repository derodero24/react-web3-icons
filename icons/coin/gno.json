{
  "$schema": "../schema.json",
  "name": "Gno",
  "source": [
    "re-export of GnosisChain — see src/chain/GnosisChain.tsx"
  ],
  "notes": [
    "The GNO token logo is the GnosisChain mark (CoinGecko token image, checked 2026-10-24), so the coin re-exports the chain icon"
  ],
  "kind": "reexport",
  "reexport": {
    "from": "../chain/GnosisChain",
    "exports": [
      {
        "of": "GnosisChain",
        "as": "Gno"
      },
      {
        "of": "GnosisChainMono",
        "as": "GnoMono"
      }
    ]
  },
  "tickers": [
    "GNO"
  ]
}
