{
  "$schema": "../schema.json",
  "name": "Gt",
  "source": [
    "re-export of Gate — see src/exchange/Gate.tsx"
  ],
  "notes": [
    "The GT token logo is the Gate mark (CoinGecko token image, checked 2026-10-24), so the coin re-exports the exchange icon"
  ],
  "kind": "reexport",
  "reexport": {
    "from": "../exchange/Gate",
    "exports": [
      {
        "of": "Gate",
        "as": "Gt"
      },
      {
        "of": "GateMono",
        "as": "GtMono"
      }
    ]
  },
  "tickers": [
    "GT"
  ]
}
