{
  "$schema": "../schema.json",
  "name": "Pol",
  "source": [
    "re-export of Polygon — see src/chain/Polygon.tsx"
  ],
  "notes": [
    "Lookup keys: the legacy ticker MATIC resolves to Pol, because MATIC was upgraded 1:1 to POL (https://docs.polygon.technology/pos/concepts/tokens/matic-to-pol: \"The migration operates on a 1:1 basis\")."
  ],
  "kind": "reexport",
  "reexport": {
    "from": "../chain/Polygon",
    "exports": [
      {
        "of": "Polygon",
        "as": "Pol"
      },
      {
        "of": "PolygonCircle",
        "as": "PolCircle"
      },
      {
        "of": "PolygonCircleMono",
        "as": "PolCircleMono"
      },
      {
        "of": "PolygonMono",
        "as": "PolMono"
      }
    ]
  },
  "tickers": [
    "POL",
    "MATIC"
  ]
}
