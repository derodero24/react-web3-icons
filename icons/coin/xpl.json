{
  "$schema": "../schema.json",
  "name": "Xpl",
  "source": [
    "re-export of Plasma — see src/chain/Plasma.tsx"
  ],
  "notes": [
    "XPL is Plasma's native token; PlasmaCircle is the official XPL token mark (token/xpl-mark.svg)."
  ],
  "kind": "reexport",
  "reexport": {
    "from": "../chain/Plasma",
    "exports": [
      {
        "of": "Plasma",
        "as": "Xpl"
      },
      {
        "of": "PlasmaMono",
        "as": "XplMono"
      },
      {
        "of": "PlasmaCircle",
        "as": "XplCircle"
      },
      {
        "of": "PlasmaCircleMono",
        "as": "XplCircleMono"
      },
      {
        "of": "PlasmaSquare",
        "as": "XplSquare"
      },
      {
        "of": "PlasmaSquareMono",
        "as": "XplSquareMono"
      }
    ]
  },
  "tickers": [
    "XPL"
  ]
}
