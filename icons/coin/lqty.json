{
  "$schema": "../schema.json",
  "name": "Lqty",
  "source": [
    "re-export of Liquity — see src/defi/Liquity.tsx"
  ],
  "notes": [
    "The LQTY token logo is the Liquity mark (CoinGecko token image, checked 2026-10-24), so the coin re-exports the defi icon"
  ],
  "kind": "reexport",
  "reexport": {
    "from": "../defi/Liquity",
    "exports": [
      {
        "of": "Liquity",
        "as": "Lqty"
      },
      {
        "of": "LiquityMono",
        "as": "LqtyMono"
      }
    ]
  },
  "tickers": [
    "LQTY"
  ]
}
