{
  "$schema": "../schema.json",
  "name": "Wld",
  "source": [
    "re-export of WorldChain — see src/chain/WorldChain.tsx (WLD uses the official World logomark, the same artwork)"
  ],
  "kind": "reexport",
  "reexport": {
    "from": "../chain/WorldChain",
    "exports": [
      {
        "of": "WorldChain",
        "as": "Wld"
      },
      {
        "of": "WorldChainMono",
        "as": "WldMono"
      }
    ]
  },
  "tickers": [
    "WLD"
  ]
}
