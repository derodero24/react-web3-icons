{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "customManagers:biomeVersions"
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 4am on tuesday"
    ],
    "recreateWhen": "always",
    "rebaseWhen": "never"
  },
  "packageRules": [
    {
      "description": "Automerge non-major devDependency updates",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Group and automerge example app dependencies (non-major)",
      "matchFileNames": [
        "example/package.json",
        "examples/stackblitz/package.json"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "example-app-dependencies",
      "automerge": true
    },
    {
      "description": "Group example app major updates (no automerge)",
      "matchFileNames": [
        "example/package.json",
        "examples/stackblitz/package.json"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "example-app-major"
    },
    {
      "description": "Do not automerge root production dependencies",
      "matchDepTypes": [
        "dependencies"
      ],
      "matchFileNames": [
        "package.json"
      ],
      "automerge": false
    },
    {
      "description": "Group and automerge non-major Biome updates: CLI, WASM build and biome.json $schema. Kept last so it overrides the example-app group; $schema deps have no depType, so automerge is set here",
      "matchPackageNames": [
        "@biomejs/biome",
        "@biomejs/wasm-nodejs"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "biome",
      "automerge": true
    }
  ]
}
